{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskMorph",
  "version": "0.1.0",
  "identifier": "com.ducthanhdev.deskmorph",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeskMorph Studio",
        "width": 980,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true
      },
      {
        "label": "taskbar",
        "title": "DeskMorph Taskbar",
        "url": "/?window=taskbar",
        "width": 1100,
        "height": 54,
        "minWidth": 100,
        "minHeight": 4,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "dock-context-menu",
        "title": "DeskMorph Context Menu",
        "url": "/?window=dock-context-menu",
        "width": 230,
        "height": 220,
        "minWidth": 100,
        "minHeight": 50,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "calendar-flyout",
        "title": "DeskMorph Calendar",
        "url": "/?window=calendar-flyout",
        "width": 320,
        "height": 340,
        "minWidth": 260,
        "minHeight": 280,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false
      },
      {
        "label": "dock-tooltip",
        "title": "DeskMorph Tooltip",
        "url": "/?window=dock-tooltip",
        "width": 250,
        "height": 44,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "devCsp": "default-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
