{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskMorph",
  "version": "0.1.0",
  "identifier": "com.ducthanhdev.deskmorph",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeskMorph Studio",
        "width": 980,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true
      },
      {
        "label": "taskbar",
        "title": "DeskMorph Taskbar",
        "url": "/?window=taskbar",
        "width": 1100,
        "height": 54,
        "minWidth": 100,
        "minHeight": 4,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": true,
        "shadow": false
      },
      {
        "label": "dock-context-menu",
        "title": "DeskMorph Context Menu",
        "url": "/?window=dock-context-menu",
        "width": 230,
        "height": 220,
        "minWidth": 100,
        "minHeight": 50,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
